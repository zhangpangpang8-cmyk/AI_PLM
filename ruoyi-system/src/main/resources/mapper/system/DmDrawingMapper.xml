    <sql id="selectDmDrawingVo">
        select id, drawing_code, drawing_name, drawing_type, drawing_version, latest_version, status, project_id, project_name, project_code, project_task_id, project_task_code, project_task_name, eco_id, eco_title, eco_code, eco_description, publish_status, file_name, file_suffix, file_size, file_path, size, remark, create_by, create_time, update_by, update_time, flow_key, flow_ins_id, bill_type, allow_change from dm_drawing
    </sql>

    <select id="selectDmDrawingList" parameterType="DmDrawing" resultMap="DmDrawingResult">
        <include refid="selectDmDrawingVo"/>
        <where>
            <!-- 精确匹配字段：去掉多余的 and，MyBatis <where> 标签会自动处理 -->
            <if test="drawingCode != null and drawingCode != ''">
                drawing_code = #{drawingCode}
            </if>
            <if test="drawingType != null and drawingType != ''">
                AND drawing_type = #{drawingType}
            </if>
            <if test="drawingVersion != null and drawingVersion != ''">
                AND drawing_version = #{drawingVersion}
            </if>
            <if test="latestVersion != null and latestVersion != ''">
                AND latest_version = #{latestVersion}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="projectCode != null and projectCode != ''">
                AND project_code = #{projectCode}
            </if>
            <if test="projectTaskCode != null and projectTaskCode != ''">
                AND project_task_code = #{projectTaskCode}
            </if>
            <if test="ecoTitle != null and ecoTitle != ''">
                AND eco_title = #{ecoTitle}
            </if>
            <if test="ecoCode != null and ecoCode != ''">
                AND eco_code = #{ecoCode}
            </if>
            <if test="publishStatus != null and publishStatus != ''">
                AND publish_status = #{publishStatus}
            </if>
            <if test="fileSuffix != null and fileSuffix != ''">
                AND file_suffix = #{fileSuffix}
            </if>
            <if test="filePath != null and filePath != ''">
                AND file_path = #{filePath}
            </if>
            <if test="flowKey != null and flowKey != ''">
                AND flow_key = #{flowKey}
            </if>
            <if test="flowInsId != null and flowInsId != ''">
                AND flow_ins_id = #{flowInsId}
            </if>
            <if test="billType != null and billType != ''">
                AND bill_type = #{billType}
            </if>
            <if test="allowChange != null and allowChange != ''">
                AND allow_change = #{allowChange}
            </if>

            <!-- 数值/Long类型字段：去掉 != '' 判断，避免类型转换异常 -->
            <if test="projectId != null">
                AND project_id = #{projectId}
            </if>
            <if test="projectTaskId != null">
                AND project_task_id = #{projectTaskId}
            </if>
            <if test="ecoId != null">
                AND eco_id = #{ecoId}
            </if>
            <if test="size != null">
                AND `size` = #{size}
            </if>

            <!-- ⚠️ 关键修复：fileSize 是数值类型，不能用 != '' 判断 -->
            <if test="fileSize != null">
                AND file_size = #{fileSize}
            </if>

            <!-- 模糊查询字段 -->
            <if test="drawingName != null and drawingName != ''">
                AND drawing_name LIKE CONCAT('%', #{drawingName}, '%')
            </if>
            <if test="projectName != null and projectName != ''">
                AND project_name LIKE CONCAT('%', #{projectName}, '%')
            </if>
            <if test="projectTaskName != null and projectTaskName != ''">
                AND project_task_name LIKE CONCAT('%', #{projectTaskName}, '%')
            </if>
            <if test="fileName != null and fileName != ''">
                AND file_name LIKE CONCAT('%', #{fileName}, '%')
            </if>

            <!-- ⚠️ 逻辑优化：描述类字段通常应该用模糊查询而非精确匹配 -->
            <if test="ecoDescription != null and ecoDescription != ''">
                AND eco_description LIKE CONCAT('%', #{ecoDescription}, '%')
            </if>
        </where>
    </select>
    
    <select id="selectDmDrawingById" parameterType="Long" resultMap="DmDrawingResult">
